<UserControl x:Class="RestaurantManager.Wpf.Views.DeliveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RestaurantManager.Wpf.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,20">
            <TextBlock Text="Management Livratori" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Content="Refresh Status" Command="{Binding RefreshCommand}" Width="120" HorizontalAlignment="Right" Padding="5"/>
        </Grid>

        <!-- Add New Driver Form -->
        <Border Grid.Row="1" Background="#f0f0f0" Padding="15" CornerRadius="5" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Nume Livrator:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Text="{Binding NewDriverName, UpdateSourceTrigger=PropertyChanged}" Width="200" Padding="5" Margin="0,0,20,0"/>
                
                <TextBlock Text="Sector Alocat:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox ItemsSource="{Binding Sectors}" SelectedItem="{Binding NewDriverSector}" Width="100" Padding="5" Margin="0,0,20,0"/>
                
                <Button Content="Adauga Livrator" Command="{Binding AddDriverCommand}" Padding="10,5" Background="#4CAF50" Foreground="White"/>
            </StackPanel>
        </Border>

        <!-- Driver List -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Drivers}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                  BorderThickness="1" BorderBrush="#ddd">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Nume" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Sector Alocat" Binding="{Binding AssignedSector}" Width="150"/>
                <DataGridCheckBoxColumn Header="In Livrare?" Binding="{Binding IsBusy}" Width="100" IsReadOnly="True"/>
                <DataGridTemplateColumn Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Sterge" 
                                    Command="{Binding DataContext.DeleteDriverCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                    CommandParameter="{Binding}"
                                    Background="#F44336" Foreground="White" Padding="5,2"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
